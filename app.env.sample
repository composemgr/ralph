# Ralph — environment variable reference
# Copy this file to app.env and adjust as needed.

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=ralph.example.com
BASE_DOMAIN_NAME=example.com

# Database — mysql or postgresql
DB_TYPE=mysql
DB_CREATE_DATABASE_NAME=ralph
DB_USER_NAME=ralph
DB_USER_PASS=replace-with-a-random-password
DB_ADMIN_PASS=replace-with-a-random-password
